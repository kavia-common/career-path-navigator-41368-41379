# Frontend environment variables
# Set the backend API base URL. For the current Kavia environment use the backend port 3010 URL below.
# IMPORTANT: Environment variables prefixed with REACT_APP_ are inlined at build time.
# After changing this file, copy to .env.local or export in your shell before running `npm start`.

# Example (current running backend):
REACT_APP_API_BASE=https://vscode-internal-30268-beta.beta01.cloud.kavia.ai:3010

# If the frontend is reverse-proxied through the same origin as the backend, you can leave this empty:
# REACT_APP_API_BASE=
