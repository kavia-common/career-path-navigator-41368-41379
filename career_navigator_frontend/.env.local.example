# Frontend → Backend base URL
# IMPORTANT: Set this to the FastAPI backend URL (check the running container details)
REACT_APP_API_BASE=https://vscode-internal-30268-beta.beta01.cloud.kavia.ai:3010

# Notes:
# - Backend CORS must allow the frontend origin:
#   allow_origins: ["https://vscode-internal-30268-beta.beta01.cloud.kavia.ai:3000"]
#   allow_credentials: true
#   allow_headers: ["*"]
#   allow_methods: ["*"]
#
# - The frontend sends Authorization: Bearer <token> once authenticated and uses
#   credentials: 'include' on fetch requests. If your backend cannot allow credentials,
#   consider switching credentials to 'omit' in src/api/client.js (not recommended here).
